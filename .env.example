# AivoBlock local development configuration (example only)
# Copy to .env for local overrides. Never commit real keys or secrets.
# Current Rust CLI reports diagnostics; these variables are not all wired
# into a running node yet. Docker Compose supplies per-node overrides.

# Custom AivoBlock development chain (NOT a public mainnet)
AIVOBLOCK_CHAIN_ID=1
AIVOBLOCK_NODE_NAME=aivoblock-dev
AIVOBLOCK_DATA_DIR=./data
AIVOBLOCK_P2P_LISTEN=127.0.0.1:30333

# Planned local-only worker executable locations
# Configure trusted paths when Haskell and Python IPC are integrated.
AIVOBLOCK_HASKELL_EXECUTABLE=
AIVOBLOCK_PYTHON_EXECUTABLE=python
AIVOBLOCK_PYTHON_WORKER=ai-engine/src/aivoblock_ai/worker.py

# Future node diagnostics and execution limits (not implemented yet)
AIVOBLOCK_LOG_LEVEL=info
AIVOBLOCK_MAX_PEERS=64
AIVOBLOCK_MAX_AI_BATCH_UNITS=1024

# Never store wallet private keys, validator signing keys, or worker
# identity secrets in this example file or in the repository.
